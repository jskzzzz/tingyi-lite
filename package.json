{
  "name": "tingyi-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "node scripts/require-local-token.mjs && vite --host 0.0.0.0",
    "dev:https": "node scripts/require-local-token.mjs && node scripts/require-https-config.mjs && vite --host 0.0.0.0 --port 5177 --mode https",
    "server": "tsx src/server/index.ts",
    "start:lite": "pwsh.exe -NoLogo -NoProfile -File scripts/start-lite.ps1",
    "cloud:sync": "tsx src/cloud/index.ts",
    "cloud:smoke": "tsx scripts/cloud-smoke.ts",
    "cloud:remote-smoke": "tsx scripts/remote-cloud-smoke.ts",
    "cloud:agent": "tsx scripts/cloud-agent-run.ts",
    "cloud:agent:batch": "tsx scripts/cloud-agent-batch.ts",
    "cloud:audio-retention": "tsx scripts/audio-retention.ts",
    "data:backup": "tsx scripts/data-backup.ts backup",
    "data:backup:verify": "tsx scripts/data-backup.ts verify",
    "data:backup:restore": "tsx scripts/data-backup.ts restore",
    "data:doctor": "tsx scripts/data-doctor.ts",
    "data:migrate:device-id": "pwsh.exe -NoLogo -NoProfile -File scripts/migrate-device-id.ps1",
    "data:migrate:capture-mode": "tsx scripts/migrate-capture-mode.ts",
    "session:export": "tsx scripts/session-export.ts export",
    "session:export:verify": "tsx scripts/session-export.ts verify",
    "build": "tsc --noEmit && vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=artifacts/portable-build/server/index.mjs",
    "build:all": "npm run build && npm run build:native-overlay && npm run build:system-captions-helper && npm run build:wasapi-loopback-helper",
    "build:native-overlay": "dotnet build native/TingyiLite.Overlay/TingyiLite.Overlay.csproj",
    "build:system-captions-helper": "dotnet build native/TingyiLite.SystemCaptionsHelper/TingyiLite.SystemCaptionsHelper.csproj",
    "build:wasapi-loopback-helper": "dotnet build native/TingyiLite.WasapiLoopbackHelper/TingyiLite.WasapiLoopbackHelper.csproj -c Release",
    "overlay:native": "dotnet run --project native/TingyiLite.Overlay --",
    "system-captions:probe": "dotnet run --project native/TingyiLite.SystemCaptionsHelper -- --probe",
    "system-captions:self-test": "dotnet run --project native/TingyiLite.SystemCaptionsHelper -- --self-test",
    "moonshine:manifest": "pwsh.exe -NoLogo -NoProfile -File scripts/write-moonshine-runtime-manifest.ps1",
    "moonshine:smoke": "tsx scripts/moonshine-smoke.ts",
    "moonshine:server-smoke": "tsx scripts/moonshine-server-smoke.ts",
    "moonshine:loopback-smoke": "tsx scripts/moonshine-loopback-smoke.ts",
    "local-asr:zh-manifest": "pwsh.exe -NoLogo -NoProfile -File scripts/write-funasr-paraformer-runtime-manifest.ps1",
    "local-asr:zh-prepare": "pwsh.exe -NoLogo -NoProfile -File scripts/prepare-funasr-paraformer-runtime.ps1",
    "local-asr:zh-smoke": "pwsh.exe -NoLogo -NoProfile -File scripts/chinese-asr-smoke.ps1",
    "local-asr:zh-loopback-smoke": "pwsh.exe -NoLogo -NoProfile -File scripts/chinese-asr-smoke.ps1 -Loopback",
    "package:lite": "pwsh.exe -NoLogo -NoProfile -File scripts/package-lite.ps1",
    "package:verify": "pwsh.exe -NoLogo -NoProfile -File scripts/verify-lite-package.ps1 -PackageRoot artifacts/portable/tingyi-lite",
    "package:smoke": "pwsh.exe -NoLogo -NoProfile -File scripts/smoke-lite-package.ps1 -PackageRoot artifacts/portable/tingyi-lite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
